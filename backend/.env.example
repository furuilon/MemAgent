# LLM 配置（OpenAI 兼容协议，一行切换供应商）
# DeepSeek 示例:
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 七牛云示例（拿到 key 后改成这样）:
# LLM_BASE_URL=https://api.qnaigc.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-v3

# Ollama 本地兜底示例:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# Embedding（留空则自动复用 LLM 配置；模型留空则使用本地轻量检索）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 检索参数
MEMORY_TOP_K=4
MEMORY_SIM_THRESHOLD=0.55
MEMORY_MAX_INJECT_TOKENS=300

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
